# Set real values in Vercel Project Settings → Environment Variables. Never commit them.
SWK_CHAT_REDIS_URL=https://YOUR-DATABASE.upstash.io
SWK_CHAT_REDIS_TOKEN=
# SHA-256 hex digest of a long random operator password; not the password itself.
SWK_CHAT_ADMIN_PASSWORD_SHA256=
# A random secret of at least 32 characters, used only by the server.
SWK_CHAT_SESSION_SECRET=
SWK_CHAT_ORIGIN=https://www.swkpropertiesuae.com
